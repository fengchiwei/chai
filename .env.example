# 少年仔、安啦會客室：設定範例（不含任何真的金鑰）
# 這個檔案只列出可以設定的項目與預設值。真正的金鑰與密碼放在 Render 的 Environment，或本機 PowerShell 視窗
# （start.bat 會詢問）；請勿把填好真值的 .env 上傳到 GitHub（.gitignore 已排除 .env）。
# 說明詳見 README.md「環境變數」與 docs/DEPLOY.md。

# --- 必填 ---
WORKBENCH_PASSWORD=          # 內建管理員 admin 的密碼（至少 10 字元）
LLM_API_KEY=                 # AI 服務金鑰（Gemini、Claude、OpenAI 相容服務皆可）；留空＝不接 AI

# --- 安全與部署 ---
SECRET_KEY=                  # 登入 session 用的隨機字串；留空＝每次啟動產生新的（重啟後要重新登入）
ANLA_DB_KEY=                 # 資料庫加密金鑰；留空＝在資料庫旁產生 anla_youth.db.key（切勿遺失或上傳）
DATABASE_PATH=               # 資料庫路徑；留空＝專案資料夾的 anla_youth.db
COOKIE_SECURE=false          # 走 HTTPS 時設 true（Render 為 true）
TRUSTED_PROXY_HOPS=0         # 在反向代理後面時設代理層數（Render 為 1）
PUBLIC_DEMO_MODE=false       # true＝公開示範網站，伺服器拒絕建立正式個案
APP_TIMEZONE=Asia/Taipei     # 記錄時間與深夜規則使用的時區
HOST=127.0.0.1               # 本機開發；讓手機連入時設 0.0.0.0
PUBLIC_URL=                  # 手機掃碼開啟的網址；Render 會自動提供
CORS_ORIGINS=                # 允許跨來源的網址（逗號分隔），預設不開放
DEBUG=false

# --- AI 服務 ---
LLM_PROVIDER=auto            # auto、gemini、anthropic、openai、deepseek、groq、openrouter、xai、mistral、custom、builtin
LLM_BASE_URL=                # custom 時必填（OpenAI 相容服務網址）
LLM_MODEL=                   # 通常留空：自動選最佳可用模型
MODEL_AUTO_SELECT=true
LLM_CALL_MODE=single         # single 或 two_stage
LLM_TEMPERATURE=0.6
LLM_EFFORT=low               # Claude 新模型的思考程度
GEMINI_THINKING=low
LLM_TURN_BUDGET=30           # 每輪 AI 呼叫合計秒數上限
LLM_CONNECT_TIMEOUT=3
LLM_CALLS_PER_MINUTE=120     # 全站每分鐘 AI 請求上限（控制費用）
DIALOGUE_SEMANTIC_ANALYSIS=true
# 舊的分家設定仍然有效：GEMINI_API_KEY、ANTHROPIC_API_KEY、OPENAI_API_KEY、OPENAI_BASE_URL、GEMINI_MODEL、OPENAI_MODEL

# --- 朗讀語音（選用）---
TTS_ENABLED=true
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=         # 例如 eastasia
TTS_OPENAI_MODEL=gpt-4o-mini-tts
TTS_GEMINI_MODEL=
TTS_CALLS_PER_MINUTE=60

# --- 限流 ---
CHAT_RATE_LIMIT=30           # 每段對話每分鐘訊息上限（橙紅訊息不受限）
LOGIN_MAX_FAILURES=5         # 10 分鐘內登入失敗上限
